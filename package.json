{
  "name": "aftercare",
  "version": "0.1.0",
  "private": true,
  "description": "State-aware purchase-resolution agent: evidence, policy constraints, explicit approvals and persistent case state decide the next justified action.",
  "license": "Apache-2.0",
  "author": "Huda Mueen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hudasol/aftercare-amazon-developer.git"
  },
  "homepage": "https://github.com/hudasol/aftercare-amazon-developer#readme",
  "bugs": {
    "url": "https://github.com/hudasol/aftercare-amazon-developer/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "streamable-http",
    "agent",
    "returns",
    "typescript",
    "sqlite"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx src/cli/reset-demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "node --import tsx src/cli/run-evaluation.ts",
    "eval:interpreters": "node --env-file-if-exists=.env --import tsx src/cli/run-interpreter-evaluation.ts",
    "mcp:smoke": "node --env-file-if-exists=.env --import tsx src/cli/mcp-smoke.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
