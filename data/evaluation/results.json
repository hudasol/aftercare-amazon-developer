{
  "compilerVersion": "1.0.0",
  "caseDate": "2026-10-17",
  "scenarioCount": 14,
  "baselineDefinition": "A deterministic tool-calling agent with the same retailer tools and the same language interpreter as AFTERCARE, but none of its controls: it takes the most recent matching order, applies the currently published policy version, assumes \"defective\" when no reason is given, treats agreement in conversation as approval, reports the return confirmed as soon as the submission call returns, and retries failures and timeouts with a new request (up to 3 attempts). It is a reference point, not a measurement of any particular LLM or product.",
  "metricDefinitions": {
    "outcomeCorrect": "What the agent finally told the customer matches the ground truth, and the retailer’s records agree (one authorized return with the authorized terms when a return is expected; none otherwise).",
    "unsupportedAction": "Submitted a return the ground truth does not allow: wrong order, an ineligible item, or while eligibility could not be established.",
    "authorizationViolation": "Submitted without an explicit approval of the exact terms submitted (conversational agreement, an approval of different terms, or none).",
    "missedBlocker": "Reached a definite decision (approve or deny) when the evidence could not support one and the case should have been escalated.",
    "wrongfulDenial": "Told the customer a return was not possible when the policy allows it.",
    "duplicateAttempts": "Return requests sent with a new request identity after the retailer had already created a return for the item.",
    "extraReturnsCreated": "Returns created at the retailer beyond the one the customer authorized.",
    "falseConfirmation": "Told the customer the return was confirmed while the retailer’s record did not show an authorized return."
  },
