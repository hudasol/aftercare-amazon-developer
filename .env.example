# AFTERCARE configuration. Every value has a safe local default; copy to .env only if you need to change one.
# No secrets are required to run the demo.

# Where the server listens. Keep 127.0.0.1 for local use.
PORT=8787
HOST=127.0.0.1

# SQLite database file (created on first start).
DATABASE_PATH=var/aftercare.db

# Fictional customer the demo surface acts as.
AFTERCARE_DEMO_CUSTOMER=cus_demo_maya

# Required (16+ characters) if HOST is not a loopback address. Callers then send
# "Authorization: Bearer <token>" to /api and /mcp.
# AFTERCARE_ACCESS_TOKEN=

# Extra browser origins allowed to call /api and /mcp, comma-separated (for a hosted deployment).
AFTERCARE_ALLOWED_ORIGINS=

# Pin a different business date for policy evaluation (default comes from data/seed/retailer.json).
# AFTERCARE_CASE_DATE=2026-10-17

# Simulated retailer timing: per-call latency, and how long a scripted timeout waits.
SANDBOX_LATENCY_MS=250
SANDBOX_TIMEOUT_MS=1500

# Serve the built web app (npm run build) from the same server.
SERVE_WEB=true
